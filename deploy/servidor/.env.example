# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.

# Production = dados reais | Staging = homologação (mesmas proteções, dados de teste)
AMBIENTE=Production

# ── Banco (Postgres local no Docker) ─────────────────────────────
POSTGRES_DB=agenciaos
POSTGRES_USER=agenciaos
# Gere com: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# ── Endereço público ─────────────────────────────────────────────
# Com Cloudflare Tunnel: https://midiaplus.seudominio.com.br
# Só na rede de casa (teste): http://192.168.0.107:8090
APP_BASE_URL=http://192.168.0.107:8090
APP_PORTA=8090

# ── Superadmin (criado na primeira subida; 12+ caracteres) ───────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── E-mail ───────────────────────────────────────────────────────
# log = não envia (só registra). Para envio real: resend + RESEND_API_KEY + EMAIL_FROM
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=

# ── Arquivos ─────────────────────────────────────────────────────
# local = disco do servidor (volume "storage"). s3 = Cloudflare R2/S3 (preencha S3_*)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Cobrança (vazio = desabilitada; contratar plano mostra erro) ─
PAYMENT_GATEWAY=desabilitado
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Cloudflare Tunnel (só para o profile "tunnel") ───────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Opcional ─────────────────────────────────────────────────────
SENTRY_DSN=
