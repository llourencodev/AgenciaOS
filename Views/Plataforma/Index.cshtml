@model List<AgenciaOS.Controllers.PlataformaController.LinhaAgencia>
@using AgenciaOS.Models
@{
    Layout = "_LayoutPlataforma";
    ViewData["Title"] = "Agências";
    var total = Model.Count;
    var ativas = Model.Count(l => l.Agencia.Status == StatusAgencia.Ativa);
    var emTeste = Model.Count(l => l.Agencia.SituacaoAssinatura == SituacaoAssinatura.Teste);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">Agências</h1>
        <p class="text-muted mb-0">Agências assinantes da plataforma</p>
    </div>
    <a asp-action="NovaAgencia" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nova agência</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted small">Cadastradas</div><div class="fs-3 fw-bold">@total</div></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted small">Ativas</div><div class="fs-3 fw-bold">@ativas</div></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted small">Em teste</div><div class="fs-3 fw-bold">@emTeste</div></div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted small">Usuários</div><div class="fs-3 fw-bold">@Model.Sum(l => l.Usuarios)</div></div></div>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="d-flex gap-2">
            <input name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Buscar por nome ou identificador" />
            <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Agência</th><th>Identificador</th><th>Status</th><th>Assinatura</th><th class="text-end">Usuários</th><th class="text-end">Clientes</th><th>Criada em</th></tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td><div class="fw-semibold">@l.Agencia.NomeExibicao</div><div class="small text-muted">@l.Agencia.EmailPrincipal</div></td>
                        <td><code>@l.Agencia.Slug</code></td>
                        <td><span class="badge @(l.Agencia.Status == StatusAgencia.Ativa ? "text-bg-success" : "text-bg-secondary")">@l.Agencia.Status</span></td>
                        <td>@l.Agencia.SituacaoAssinatura</td>
                        <td class="text-end">@l.Usuarios</td>
                        <td class="text-end">@l.Clientes</td>
                        <td class="small text-muted">@l.Agencia.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma agência encontrada.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
