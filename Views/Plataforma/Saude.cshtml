@model AgenciaOS.Controllers.PlataformaController.PainelSaude
@using Microsoft.Extensions.Diagnostics.HealthChecks
@{
    Layout = "_LayoutPlataforma";
    ViewData["Title"] = "Saúde da operação";
    string Badge(HealthStatus s) => s switch { HealthStatus.Healthy => "text-bg-success", HealthStatus.Degraded => "text-bg-warning", _ => "text-bg-danger" };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 fw-bold mb-0">Saúde da operação</h1>
    <a href="/status" target="_blank" class="btn btn-sm btn-outline-secondary">Página pública de status</a>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card p-3"><div class="small text-muted">Contas de marketing com erro/token expirado</div><div class="fs-4 fw-bold @(Model.ContasMarketingComErro > 0 ? "text-warning" : "")">@Model.ContasMarketingComErro</div></div></div>
    <div class="col-md-4"><div class="card p-3"><div class="small text-muted">Webhooks de pagamento com falha</div><div class="fs-4 fw-bold @(Model.WebhooksComFalha > 0 ? "text-danger" : "")">@Model.WebhooksComFalha</div></div></div>
    <div class="col-md-4"><div class="card p-3"><div class="small text-muted">Pedidos LGPD atrasados</div><div class="fs-4 fw-bold @(Model.PedidosPrivacidadeAtrasados > 0 ? "text-danger" : "")">@Model.PedidosPrivacidadeAtrasados</div></div></div>
</div>
<div class="card">
    <div class="card-body">
        <p>Situação geral: <span class="badge @Badge(Model.Relatorio.Status)">@Model.Relatorio.Status</span> · verificação em @Model.Relatorio.TotalDuration.TotalMilliseconds.ToString("0") ms</p>
        <table class="table table-sm mb-0">
            <thead><tr><th>Componente</th><th>Situação</th><th>Detalhe</th><th>Dados</th></tr></thead>
            @foreach (var (nome, e) in Model.Relatorio.Entries)
            {
                <tr>
                    <td><code>@nome</code></td>
                    <td><span class="badge @Badge(e.Status)">@e.Status</span></td>
                    <td class="small">@e.Description @(e.Exception != null ? $"({e.Exception.GetType().Name})" : "")</td>
                    <td class="small text-muted">@string.Join(", ", e.Data.Select(d => $"{d.Key}: {System.Text.Json.JsonSerializer.Serialize(d.Value)}"))</td>
                </tr>
            }
        </table>
    </div>
</div>
