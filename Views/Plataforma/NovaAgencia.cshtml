@model AgenciaOS.Controllers.PlataformaController.NovaAgenciaInput
@{
    Layout = "_LayoutPlataforma";
    ViewData["Title"] = "Nova agência";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Nova agência</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>

<form asp-action="NovaAgencia" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Dados da agência</h2>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Nome / razão social *</label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger small"></span></div>
                        <div class="col-md-6"><label class="form-label">Nome comercial</label><input asp-for="NomeFantasia" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Identificador (slug)</label><input asp-for="Slug" class="form-control" placeholder="gerado a partir do nome" /><span asp-validation-for="Slug" class="text-danger small"></span></div>
                        <div class="col-md-6"><label class="form-label">CNPJ</label><input asp-for="Cnpj" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">E-mail principal</label><input asp-for="EmailPrincipal" type="email" class="form-control" /><span asp-validation-for="EmailPrincipal" class="text-danger small"></span></div>
                        <div class="col-md-6"><label class="form-label">Telefone</label><input asp-for="Telefone" class="form-control" /></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Primeiro administrador</h2>
                    <div class="mb-3"><label class="form-label">Nome *</label><input asp-for="AdminNome" class="form-control" /><span asp-validation-for="AdminNome" class="text-danger small"></span></div>
                    <div class="mb-3"><label class="form-label">E-mail *</label><input asp-for="AdminEmail" type="email" class="form-control" /><span asp-validation-for="AdminEmail" class="text-danger small"></span></div>
                    <div class="mb-3"><label class="form-label">Senha provisória *</label><input asp-for="AdminSenha" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="AdminSenha" class="text-danger small"></span>
                        <div class="form-text">Mínimo de 10 caracteres. Na Fase 3 isto vira um convite por e-mail.</div></div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> Criar agência</button>
                </div>
            </div>
        </div>
    </div>
</form>
