@model AgenciaOS.Controllers.PlataformaController.DetalhesAgencia
@using AgenciaOS.Models
@{
    Layout = "_LayoutPlataforma";
    var a = Model.Agencia;
    ViewData["Title"] = a.NomeExibicao;
    var br = new System.Globalization.CultureInfo("pt-BR");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">@a.NomeExibicao</h1>
        <p class="text-muted mb-0"><code>@a.Slug</code> · criada em @a.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy") · @Model.Clientes cliente(s)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Agências</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 fw-bold">Situação</h2>
            <p class="mb-1">Conta: <span class="badge @(a.Status == StatusAgencia.Ativa ? "text-bg-success" : "text-bg-danger")">@a.Status</span>
                @if (!string.IsNullOrEmpty(a.MotivoSuspensao)) { <span class="small text-muted">(@a.MotivoSuspensao)</span> }</p>
            <p class="mb-1">Assinatura: <strong>@(a.Isenta ? "Isenta" : a.SituacaoAssinatura.ToString())</strong>
                @if (a.TesteExpiraEm is { } t && !a.Isenta) { <span class="small text-muted">· teste até @t.ToLocalTime().ToString("dd/MM/yyyy")</span> }</p>
            <p class="mb-3">Plano: <strong>@(Model.Assinatura?.Plano?.Nome ?? a.PlanoCodigo ?? "—")</strong>
                @if (Model.Assinatura != null) { <span class="small text-muted">· @Model.Assinatura.Valor.ToString("C", br) · @Model.Assinatura.FormaPagamento</span> }</p>

            @if (a.Status == StatusAgencia.Ativa)
            {
                <form asp-action="Suspender" asp-route-id="@a.Id" method="post" class="d-flex gap-2 mb-2">
                    <input name="motivo" class="form-control form-control-sm" placeholder="Motivo da suspensão (obrigatório)" />
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Suspender a agência e encerrar as sessões dos usuários?')">Suspender</button>
                </form>
            }
            else
            {
                <form asp-action="Reativar" asp-route-id="@a.Id" method="post" class="mb-2"><button class="btn btn-sm btn-success">Reativar agência</button></form>
            }
            <form asp-action="Isencao" asp-route-id="@a.Id" method="post" class="mb-2">
                <input type="hidden" name="isenta" value="@(!a.Isenta)" />
                <button class="btn btn-sm btn-outline-secondary">@(a.Isenta ? "Remover isenção" : "Isentar de assinatura")</button>
            </form>
            <form asp-action="EstenderTeste" asp-route-id="@a.Id" method="post" class="d-flex gap-2 mb-2">
                <input name="dias" type="number" min="1" max="90" value="7" class="form-control form-control-sm" style="width:90px;" />
                <button class="btn btn-sm btn-outline-secondary">Estender teste (dias)</button>
            </form>
            <form asp-action="AlterarPlanoAgencia" asp-route-id="@a.Id" method="post" class="d-flex gap-2">
                <select name="planoId" class="form-select form-select-sm">
                    @foreach (var p in Model.Planos) { <option value="@p.Id" selected="@(p.Codigo == a.PlanoCodigo)">@p.Nome — @p.Preco.ToString("C", br)</option> }
                </select>
                <button class="btn btn-sm btn-outline-primary">Alterar plano</button>
            </form>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 fw-bold">Usuários (@Model.Usuarios.Count)</h2>
            <div class="table-responsive" style="max-height:280px;">
                <table class="table table-sm mb-0">
                    @foreach (var u in Model.Usuarios)
                    {
                        <tr><td>@u.NomeCompleto</td><td class="small text-muted">@u.Email</td><td class="small">@u.Tipo</td><td class="small">@(u.Ativo ? "ativo" : "inativo")</td><td class="small text-muted">@u.UltimoAcesso?.ToLocalTime().ToString("dd/MM/yy")</td></tr>
                    }
                </table>
            </div>
        </div></div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <h2 class="h6 fw-bold">Pagamentos</h2>
            <table class="table table-sm mb-0">
                <thead><tr><th>Vencimento</th><th>Valor</th><th>Situação</th><th>Pago em</th></tr></thead>
                @foreach (var p in Model.Pagamentos)
                {
                    <tr><td>@p.Vencimento?.ToString("dd/MM/yyyy")</td><td>@p.Valor.ToString("C", br)</td><td>@p.Status</td><td>@p.PagoEm?.ToLocalTime().ToString("dd/MM/yyyy")</td></tr>
                }
                @if (Model.Pagamentos.Count == 0) { <tr><td colspan="4" class="text-muted">Nenhum pagamento.</td></tr> }
            </table>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <h2 class="h6 fw-bold">Atividades recentes</h2>
            <div style="max-height:320px;overflow:auto;">
                <table class="table table-sm mb-0">
                    @foreach (var r in Model.Atividades)
                    {
                        <tr><td class="small text-muted text-nowrap">@r.Quando.ToLocalTime().ToString("dd/MM HH:mm")</td><td class="small"><code>@r.Acao</code></td><td class="small text-muted">@r.UsuarioEmail</td></tr>
                    }
                </table>
            </div>
            <a asp-action="Auditoria" asp-route-agenciaId="@a.Id" class="small">Ver auditoria completa</a>
        </div></div>
    </div>
</div>
