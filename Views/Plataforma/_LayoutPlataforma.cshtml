<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Plataforma AgenciaOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f5f6fa; }
        .plataforma-topo { background: #0f0d22; }
        .plataforma-topo .navbar-brand { font-weight: 800; letter-spacing: -.02em; }
        .badge-plataforma { background: #6366f1; }
        .card { border: 0; box-shadow: 0 1px 3px rgba(15,13,34,.08); border-radius: 12px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark plataforma-topo px-3 px-md-4">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Plataforma" asp-action="Index">
            <i class="bi bi-grid-1x2-fill"></i> AgenciaOS <span class="badge badge-plataforma fw-semibold">Plataforma</span>
        </a>
        <div class="d-flex flex-wrap align-items-center gap-3 small">
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Index">Agências</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Planos">Planos</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Privacidade">Privacidade</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Auditoria">Auditoria</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Saude">Saúde</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Plataforma" asp-action="Configuracoes">Configurações</a>
            <a class="text-white-50 text-decoration-none" asp-controller="Conta" asp-action="Seguranca">Minha conta</a>
            <span class="d-none d-lg-inline text-white-50">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Sair</button>
            </form>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Sucesso"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
