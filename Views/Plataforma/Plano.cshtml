@model AgenciaOS.Models.Plano
@{
    Layout = "_LayoutPlataforma";
    ViewData["Title"] = Model.Id == 0 ? "Novo plano" : "Editar plano";
    var modulos = Model.ListaModulos;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">@ViewData["Title"]</h1>
    <a asp-action="Planos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>
<form asp-action="Plano" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card"><div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label">Nome *</label><input asp-for="Nome" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Código</label><input asp-for="Codigo" class="form-control" placeholder="gerado do nome" /></div>
                    <div class="col-12"><label class="form-label">Descrição</label><textarea asp-for="Descricao" class="form-control" rows="2"></textarea></div>
                    <div class="col-md-4"><label class="form-label">Preço (R$) *</label><input asp-for="Preco" class="form-control" type="number" step="0.01" min="0" /></div>
                    <div class="col-md-4"><label class="form-label">Periodicidade</label>
                        <select asp-for="Periodicidade" class="form-select" asp-items="Html.GetEnumSelectList<AgenciaOS.Models.Periodicidade>()"></select></div>
                    <div class="col-md-4"><label class="form-label">Ordem na vitrine</label><input asp-for="Ordem" class="form-control" type="number" /></div>
                    <div class="col-12"><label class="form-label">Recursos (um por linha)</label><textarea asp-for="RecursosAdicionais" class="form-control" rows="4"></textarea></div>
                    <div class="col-12 form-check ms-2"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">À venda (aparece para novas contratações)</label></div>
                </div>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card"><div class="card-body">
                <h2 class="h6 fw-bold">Limites (vazio = sem limite)</h2>
                <div class="mb-3"><label class="form-label">Usuários da equipe</label><input asp-for="LimiteUsuarios" class="form-control" type="number" min="1" /></div>
                <div class="mb-3"><label class="form-label">Clientes ativos</label><input asp-for="LimiteClientes" class="form-control" type="number" min="1" /></div>
                <div class="mb-3"><label class="form-label">Armazenamento (MB)</label><input asp-for="LimiteArmazenamentoMb" class="form-control" type="number" min="1" /></div>
                <h2 class="h6 fw-bold mt-4">Módulos (nenhum marcado = todos)</h2>
                <div class="row g-1">
                    @foreach (var m in AgenciaOS.Controllers.PlataformaController.ModulosDisponiveis)
                    {
                        <div class="col-6 form-check">
                            <input class="form-check-input" type="checkbox" name="modulos" value="@m" id="mod_@m" checked="@(modulos.Contains(m))" />
                            <label class="form-check-label small" for="mod_@m">@m</label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-4"><i class="bi bi-check-lg"></i> Salvar plano</button>
            </div></div>
        </div>
    </div>
</form>
