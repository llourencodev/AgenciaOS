@model AgenciaOS.Controllers.StatusController.Painel
@{
    Layout = null;
    string Cor(string s) => s switch { "Operacional" => "#10b981", "Instabilidade" => "#f59e0b", _ => "#ef4444" };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="60" />
    <title>Status — Midia+</title>
    <partial name="_BrandHead" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>body{font-family:'Inter',sans-serif;background:#f5f6fa}.topo{background:#0f0d22;color:#fff}.ponto{width:12px;height:12px;border-radius:50%;display:inline-block}</style>
</head>
<body>
    <div class="topo py-3 px-3 px-md-4 fw-bold"><img src="/brand/midia-plus-logo-white.png" alt="Midia+" style="height:24px;width:auto;vertical-align:-6px;" /> · Status</div>
    <main class="container py-4" style="max-width:720px;">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="ponto" style="background:@Cor(Model.Geral);width:16px;height:16px;"></span>
                <div>
                    <div class="fs-5 fw-bold">@(Model.Geral == "Operacional" ? "Todos os sistemas operacionais" : Model.Geral == "Instabilidade" ? "Instabilidade parcial" : "Indisponibilidade")</div>
                    <div class="small text-muted">Verificado em @Model.VerificadoEm.ToString("dd/MM/yyyy HH:mm") UTC · atualiza a cada minuto</div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <ul class="list-group list-group-flush">
                @foreach (var c in Model.Componentes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>@c.Nome</span>
                        <span class="small fw-semibold" style="color:@Cor(c.Situacao)"><span class="ponto me-1" style="background:@Cor(c.Situacao)"></span>@c.Situacao</span>
                    </li>
                }
            </ul>
        </div>
        <p class="small text-muted text-center mt-4 mb-0">Formato para monitores: <a href="/status.json">/status.json</a></p>
    </main>
</body>
</html>
