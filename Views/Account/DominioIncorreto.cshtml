@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Endereço de outra agência";
}
<div class="text-center">
    <div style="font-size:48px;color:#f59e0b;"><i class="bi bi-signpost-split"></i></div>
    <div class="login-form-title">Endereço de outra agência</div>
    <p class="text-muted">Você está conectado com uma conta que não pertence à agência deste endereço. Use o endereço da sua agência ou o site do AgenciaOS.</p>
    <form asp-action="Logout" method="post"><button class="btn btn-outline-secondary mt-2">Sair desta sessão</button></form>
</div>
