@model AgenciaOS.ViewModels.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar — AgenciaOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body style="font-family:'Inter',sans-serif;">
<div class="login-wrap">
    <!-- LEFT PANEL -->
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo-big"><i class="bi bi-lightning-charge-fill"></i></div>
            <div class="login-tagline">Gerencie sua agência<br>em um só lugar</div>
            <div class="login-sub">Plataforma completa para agências de marketing digital</div>
            <ul class="login-features">
                <li><i class="bi bi-check-circle-fill"></i> Calendário de conteúdo visual</li>
                <li><i class="bi bi-check-circle-fill"></i> Aprovação de materiais pelo cliente</li>
                <li><i class="bi bi-check-circle-fill"></i> Gestão de tarefas no estilo Kanban</li>
                <li><i class="bi bi-check-circle-fill"></i> Controle financeiro integrado</li>
                <li><i class="bi bi-check-circle-fill"></i> Arquivos organizados por cliente</li>
            </ul>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="login-right">
        <div class="login-form-wrap">
            <div class="mb-4">
                <div class="login-form-title">Bem-vindo de volta 👋</div>
                <div class="login-form-sub">Entre com suas credenciais para acessar a plataforma</div>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3" style="font-size:13px;border-radius:8px;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="seu@email.com" autocomplete="email" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Senha</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Senha" class="form-control" type="password" placeholder="••••••••" autocomplete="current-password" id="senhaInput" />
                        <button type="button" class="input-group-text bg-white cursor-pointer" onclick="toggleSenha()" style="cursor:pointer;">
                            <i class="bi bi-eye" id="senhaIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check mb-0">
                        <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMe" />
                        <label class="form-check-label" for="lembrarMe" style="font-size:13px;">Lembrar-me por 7 dias</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2" style="font-size:14px;font-weight:600;border-radius:10px;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Entrar na plataforma
                </button>
            </form>

            <div class="text-center mt-4" style="font-size:12px;color:#9ca3af;">
                <i class="bi bi-shield-check me-1"></i> Acesso protegido · Problemas? Contate o administrador.
            </div>
        </div>
    </div>
</div>
<script>
function toggleSenha() {
    const input = document.getElementById('senhaInput');
    const icon = document.getElementById('senhaIcon');
    if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else { input.type = 'password'; icon.className = 'bi bi-eye'; }
}
</script>
</body>
</html>
