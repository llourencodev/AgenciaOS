@model AgenciaOS.Models.Usuario
@{
    ViewData["Title"] = "Segurança da conta";
    if (ViewData["Layout"] is string layout) { Layout = layout; }
}

<div class="page-header">
    <div>
        <h1>Segurança da conta</h1>
        <p>@Model.Email</p>
    </div>
</div>

@if (Layout?.Contains("Plataforma") == true)
{
    @if (TempData["Sucesso"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
}

<div class="row g-3">
    @if (!(User.IsInRole("SuperAdmin") && Model.AgenciaId == null))
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><span class="card-title">Alterar e-mail de acesso</span></div>
                <div class="card-body">
                    <form asp-action="SolicitarTrocaEmail" method="post">
                        <div class="mb-3">
                            <label class="form-label">E-mail atual</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Novo e-mail</label>
                            <input type="email" name="novoEmail" class="form-control" required maxlength="256" autocomplete="off" placeholder="novo@email.com" />
                            @if (ViewData["TrocaEmailImediata"] is true)
                            {
                                <div class="form-text">A troca vale na hora: depois de salvar, entre com o novo e-mail.</div>
                            }
                            else
                            {
                                <div class="form-text">Enviaremos um link de confirmação para o novo endereço. O login só muda depois da confirmação.</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Senha atual</label>
                            <input type="password" name="senhaAtual" class="form-control" required autocomplete="current-password" />
                        </div>
                        <button type="submit" class="btn btn-primary">Alterar e-mail</button>
                    </form>
                </div>
            </div>
        </div>
    }
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><span class="card-title">Alterar senha</span></div>
            <div class="card-body">
                <form asp-action="AlterarSenha" method="post">
                    <div class="mb-3">
                        <label class="form-label">Senha atual</label>
                        <input type="password" name="senhaAtual" class="form-control" required autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nova senha</label>
                        <input type="password" name="novaSenha" class="form-control" required minlength="10" autocomplete="new-password" />
                        <div class="form-text">10+ caracteres, com letra maiúscula, minúscula e número.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirmar nova senha</label>
                        <input type="password" name="confirmarSenha" class="form-control" required autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary">Salvar nova senha</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><span class="card-title">Sessões</span></div>
            <div class="card-body">
                <p class="text-sm text-muted">Último acesso: @(Model.UltimoAcesso?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
                <p class="text-sm">Esqueceu a conta aberta em outro computador ou celular? Encerre todas as outras sessões. Esta continua ativa.</p>
                <form asp-action="EncerrarOutrasSessoes" method="post">
                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i> Encerrar outras sessões</button>
                </form>
                <hr />
                <p class="text-sm mb-2"><i class="bi bi-shield-lock me-1"></i>Autenticação em duas etapas:
                    <strong>@(Model.TwoFactorEnabled ? "ativa" : "desativada")</strong></p>
                <a asp-action="DoisFatores" class="btn btn-sm @(Model.TwoFactorEnabled ? "btn-outline-secondary" : "btn-primary")">
                    @(Model.TwoFactorEnabled ? "Gerenciar" : "Ativar com aplicativo autenticador")
                </a>
            </div>
        </div>
    </div>
</div>
