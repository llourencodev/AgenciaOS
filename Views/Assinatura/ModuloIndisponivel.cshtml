@{
    ViewData["Title"] = "Módulo indisponível";
}
<div class="card mx-auto" style="max-width:560px;">
    <div class="card-body text-center py-5">
        <div style="font-size:48px;color:#6366f1;"><i class="bi bi-stars"></i></div>
        <h1 class="h4 fw-bold mt-2">@ViewData["Modulo"] não faz parte do plano atual</h1>
        <p class="text-muted">Faça upgrade para liberar este módulo.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Planos" class="btn btn-primary">Ver planos</a>
        }
        else
        {
            <p class="text-muted mb-0">Fale com o administrador da agência.</p>
        }
    </div>
</div>
