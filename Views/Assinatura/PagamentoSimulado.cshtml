@model AgenciaOS.Models.Pagamento
@{
    ViewData["Title"] = "Pagamento simulado";
}
<div class="card mx-auto" style="max-width:560px;">
    <div class="card-body py-4">
        <div class="alert alert-warning small"><strong>Ambiente de desenvolvimento.</strong> Esta página substitui o checkout do Asaas e simula o webhook do gateway. Não existe em produção.</div>
        <h1 class="h5 fw-bold">Cobrança @Model.GatewayPagamentoId</h1>
        <p class="mb-3">Valor: <strong>@Model.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></p>
        <form asp-action="PagamentoSimulado" method="post" class="d-flex gap-2">
            <input type="hidden" name="cobranca" value="@Model.GatewayPagamentoId" />
            <button name="evento" value="PAYMENT_RECEIVED" class="btn btn-success">Simular pagamento recebido</button>
            <button name="evento" value="PAYMENT_OVERDUE" class="btn btn-outline-danger">Simular atraso</button>
        </form>
    </div>
</div>
