@model IEnumerable<AgenciaOS.Models.Financeiro>
@using AgenciaOS.Models
@{
    ViewData["Title"] = "Contas a Receber";
    var clientes = ViewData["Clientes"] as IEnumerable<Cliente> ?? [];
    var mes      = (int)ViewData["Mes"]!;
    var ano      = (int)ViewData["Ano"]!;
    var aReceber = (decimal)ViewData["AReceber"]!;
    var receita  = (decimal)ViewData["Receita"]!;
    var cultura  = new System.Globalization.CultureInfo("pt-BR");
    var vencidas      = ViewData["Vencidas"] as bool?;
    var clienteId     = ViewData["ClienteId"];
    var respFiltro    = ViewData["ResponsavelId"] as string;
    var usuarios      = ViewData["Usuarios"] as IEnumerable<Usuario> ?? [];
    string NomeMes(int m) => new DateTime(2000, m, 1).ToString("MMMM", cultura);

    var totalPendente = Model.Where(f => !f.Pago).Sum(f => f.Valor);
    var totalRecebido = Model.Where(f => f.Pago).Sum(f => f.Valor);
    var totalVencidas = Model.Count(f => !f.Pago && f.DataVencimento < DateTime.Now);
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-arrow-down-circle-fill text-success me-2" style="font-size:22px;"></i>Contas a Receber</h1>
        <p style="text-transform:capitalize;">@NomeMes(mes) de @ano · @Model.Count() lançamentos</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-mes="@mes" asp-route-ano="@ano" class="btn btn-outline-secondary">
            <i class="bi bi-grid me-1"></i> Visão Geral
        </a>
        <a asp-action="ContasPagar" asp-route-mes="@mes" asp-route-ano="@ano" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-up-circle me-1 text-danger"></i> Contas a Pagar
        </a>
        <button class="btn btn-success px-4" data-bs-toggle="modal" data-bs-target="#novaContaModal">
            <i class="bi bi-plus-lg me-1"></i> Nova Conta
        </button>
    </div>
</div>

<!-- RESUMO -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center py-3 px-2" style="border-top:3px solid var(--success);">
            <div class="fw-800 fs-4 text-success">@totalRecebido.ToString("C0", cultura)</div>
            <div class="text-muted small">Recebido</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center py-3 px-2" style="border-top:3px solid var(--info);">
            <div class="fw-800 fs-4 text-info">@totalPendente.ToString("C0", cultura)</div>
            <div class="text-muted small">Pendente</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center py-3 px-2" style="border-top:3px solid var(--danger);">
            <div class="fw-800 fs-4 text-danger">@totalVencidas</div>
            <div class="text-muted small">Vencidas</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center py-3 px-2" style="border-top:3px solid var(--primary);">
            <div class="fw-800 fs-4" style="color:var(--primary);">@Model.Count()</div>
            <div class="text-muted small">Total lançamentos</div>
        </div>
    </div>
</div>

<!-- FILTROS -->
<div class="filter-bar justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ContasReceber" asp-route-mes="@(mes==1?12:mes-1)" asp-route-ano="@(mes==1?ano-1:ano)" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-chevron-left"></i>
        </a>
        <span class="fw-700" style="min-width:155px;text-align:center;text-transform:capitalize;">@NomeMes(mes) @ano</span>
        <a asp-action="ContasReceber" asp-route-mes="@(mes==12?1:mes+1)" asp-route-ano="@(mes==12?ano+1:ano)" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-chevron-right"></i>
        </a>
    </div>
    <form method="get" class="d-flex gap-2 flex-wrap">
        <select name="clienteId" class="form-select form-select-sm" style="width:180px;" onchange="this.form.submit()">
            <option value="">Todos os clientes</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Id" selected="@(clienteId?.ToString() == c.Id.ToString())">@c.NomeEmpresa</option>
            }
        </select>
        <select name="responsavelId" class="form-select form-select-sm" style="width:160px;" onchange="this.form.submit()">
            <option value="">Todos responsáveis</option>
            @foreach (var u in usuarios)
            {
                <option value="@u.Id" selected="@(respFiltro == u.Id)">@u.Nome</option>
            }
        </select>
        <select name="vencidas" class="form-select form-select-sm" style="width:135px;" onchange="this.form.submit()">
            <option value="">Todas</option>
            <option value="true" selected="@(vencidas == true)">Somente Vencidas</option>
        </select>
        <input type="hidden" name="mes" value="@mes" />
        <input type="hidden" name="ano" value="@ano" />
    </form>
</div>

<!-- TABELA -->
<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Cliente</th>
                        <th>Categoria</th>
                        <th>Vencimento</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th>Recebido em</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        var vencida = !f.Pago && f.DataVencimento < DateTime.Now;
                        <tr class="@(vencida ? "table-danger" : "")">
                            <td>
                                <div class="fw-600">@f.Descricao</div>
                                @if (!string.IsNullOrEmpty(f.Observacoes))
                                {
                                    <div class="text-xs text-muted">@f.Observacoes</div>
                                }
                            </td>
                            <td class="text-sm">@(f.Cliente?.NomeEmpresa ?? "—")</td>
                            <td><span class="badge badge-pauta">@f.Categoria</span></td>
                            <td class="@(vencida ? "text-danger fw-600" : "text-sm")">
                                @f.DataVencimento.ToString("dd/MM/yyyy")
                                @if (vencida) { <i class="bi bi-exclamation-circle-fill"></i> }
                            </td>
                            <td class="fw-700 text-success">+@f.Valor.ToString("C0", cultura)</td>
                            <td>
                                <button class="btn btn-sm @(f.Pago ? "btn-success" : "btn-outline-secondary")"
                                        data-pago-toggle="@f.Id" style="font-size:12px;min-width:110px;">
                                    <i class="bi bi-@(f.Pago ? "check-circle-fill" : "circle") me-1"></i>
                                    @(f.Pago ? "Recebido" : "Pendente")
                                </button>
                            </td>
                            <td class="text-sm text-muted">
                                @(f.DataPagamento.HasValue ? f.DataPagamento.Value.ToString("dd/MM/yyyy") : "—")
                            </td>
                            <td class="text-end">
                                <button class="btn btn-xs btn-outline-danger" onclick="excluir(@f.Id, this)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background:#f8fafc;">
                    <tr>
                        <td colspan="4" class="fw-700 text-sm">Total do período</td>
                        <td class="fw-700 text-success">+@Model.Sum(f => f.Valor).ToString("C0", cultura)</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-arrow-down-circle empty-state-icon text-success"></i>
            <h5>Nenhuma conta a receber</h5>
            <p>Cadastre suas receitas e mensalidades dos clientes.</p>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#novaContaModal">
                <i class="bi bi-plus-lg me-1"></i> Adicionar Conta
            </button>
        </div>
    }
</div>

<!-- MODAL -->
<div class="modal fade" id="novaContaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Financeiro" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Tipo" value="Entrada" />
                <div class="modal-header" style="border-left:4px solid var(--success);">
                    <h5 class="modal-title"><i class="bi bi-arrow-down-circle-fill text-success me-2"></i>Nova Conta a Receber</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Descrição *</label>
                        <input type="text" name="Descricao" class="form-control" required placeholder="Ex: Mensalidade Janeiro — Cliente X" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Valor *</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input type="number" name="Valor" class="form-control" step="0.01" min="0" required placeholder="0,00" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Vencimento *</label>
                            <input type="date" name="DataVencimento" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Categoria</label>
                            <select name="Categoria" class="form-select">
                                <option value="Mensalidade">Mensalidade</option>
                                <option value="Projeto">Projeto</option>
                                <option value="PagamentoExtra">Pagamento Extra</option>
                                <option value="Outros">Outros</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Cliente</label>
                            <select name="ClienteId" class="form-select">
                                <option value="">Sem vínculo</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.Id" selected="@(clienteId?.ToString() == c.Id.ToString())">@c.NomeEmpresa</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observações</label>
                            <textarea name="Observacoes" class="form-control" rows="2" placeholder="Notas adicionais..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Pago" value="true" id="jaRecebido" />
                                <label class="form-check-label" for="jaRecebido">Já foi recebido</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function excluir(id, btn) {
    if (!confirm('Excluir este lançamento?')) return;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const res = await fetch(`/Financeiro/Excluir/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': token } });
    if (res.ok) btn.closest('tr').remove();
}
</script>
}
