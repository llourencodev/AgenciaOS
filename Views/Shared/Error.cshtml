@model ErrorViewModel
@{
    // Sem o layout principal: ele consulta o banco, e a página de erro precisa abrir mesmo se o banco falhar
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Titulo — AgenciaOS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:#f5f6fa; font-family:Inter,Segoe UI,Arial,sans-serif; color:#111827; padding:16px; box-sizing:border-box; }
        .caixa { background:#fff; border-radius:16px; box-shadow:0 10px 40px rgba(15,23,42,.08); max-width:560px; width:100%; padding:36px 32px; }
        .icone { width:52px; height:52px; border-radius:14px; background:#fef2f2; color:#dc2626; display:flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:18px; }
        h1 { font-size:22px; margin:0 0 10px; font-weight:800; }
        p { font-size:15px; line-height:1.6; color:#374151; margin:0 0 18px; }
        .codigo { font-size:12px; color:#6b7280; }
        .codigo code { background:#f3f4f6; padding:2px 6px; border-radius:6px; }
        .botoes { display:flex; gap:10px; flex-wrap:wrap; margin-top:22px; }
        .botoes a { text-decoration:none; padding:10px 18px; border-radius:10px; font-weight:600; font-size:14px; }
        .primario { background:#4f46e5; color:#fff; }
        .secundario { background:#f1f5f9; color:#334155; }
        details { margin-top:20px; font-size:12px; }
        pre { white-space:pre-wrap; word-break:break-word; background:#0f172a; color:#e2e8f0; padding:12px; border-radius:10px; max-height:320px; overflow:auto; }
    </style>
</head>
<body>
    <div class="caixa">
        <div class="icone"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <h1>@Model.Titulo</h1>
        <p>@Model.Mensagem</p>
        @if (Model.ShowRequestId)
        {
            <div class="codigo">Código do erro (@Model.StatusCode): <code>@Model.RequestId</code></div>
        }
        <div class="botoes">
            <a href="javascript:history.back()" class="secundario"><i class="bi bi-arrow-left"></i> Voltar</a>
            <a href="/" class="primario">Ir para o início</a>
        </div>
        @if (!string.IsNullOrEmpty(Model.Detalhe))
        {
            <details>
                <summary>Detalhe técnico (só aparece no ambiente local)</summary>
                <pre>@Model.Detalhe</pre>
            </details>
        }
    </div>
</body>
</html>
