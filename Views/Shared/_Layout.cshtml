<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AgenciaOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    @inject AgenciaOS.Data.ApplicationDbContext _layoutDb
    @inject Microsoft.AspNetCore.Identity.UserManager<AgenciaOS.Models.Usuario> _layoutUserMgr

    var _currentUser = await _layoutUserMgr.GetUserAsync(User);
    var _abas = _currentUser?.AbasPermitidas?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? [];
    bool TemAcesso(string aba) => !_abas.Any() || User.IsInRole("Admin") || _abas.Contains(aba);
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    <!-- SIDEBAR -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="brand-text">
                <span class="brand-name">AgenciaOS</span>
                <span class="brand-tagline">Gestão de Agência</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <!-- GESTÃO -->
            <div class="nav-group">
                <div class="nav-group-label">GESTÃO</div>
                @if (TemAcesso("Dashboard"))
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link-item @(ctrl == "Dashboard" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                        <span>Dashboard</span>
                    </a>
                }
                @if (TemAcesso("Tarefas"))
                {
                    <a asp-controller="Tarefas" asp-action="Index" class="nav-link-item @(ctrl == "Tarefas" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-kanban-fill"></i></span>
                        <span>Tarefas</span>
                    </a>
                }
                @if ((User.IsInRole("Admin") || User.IsInRole("Equipe")) && TemAcesso("Financeiro"))
                {
                    <a asp-controller="Financeiro" asp-action="Index" class="nav-link-item @(ctrl == "Financeiro" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>Financeiro</span>
                    </a>
                }
            </div>

            <!-- CRIATIVO -->
            <div class="nav-group">
                <div class="nav-group-label">CRIATIVO</div>
                @if (TemAcesso("Calendario"))
                {
                    <a asp-controller="Calendario" asp-action="Index" class="nav-link-item @(ctrl == "Calendario" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-calendar3-week-fill"></i></span>
                        <span>Calendário</span>
                    </a>
                }
                @if (TemAcesso("Arquivos"))
                {
                    <a asp-controller="Arquivos" asp-action="Index" class="nav-link-item @(ctrl == "Arquivos" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-folder2-open"></i></span>
                        <span>Arquivos</span>
                    </a>
                }
                @if (TemAcesso("DatasComemorativas"))
                {
                    <a asp-controller="DatasComemorativas" asp-action="Index" class="nav-link-item @(ctrl == "DatasComemorativas" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-calendar-heart-fill"></i></span>
                        <span>Datas Comemorativas</span>
                    </a>
                }
            </div>

            <!-- COMERCIAL -->
            <div class="nav-group">
                <div class="nav-group-label">COMERCIAL</div>
                @if (TemAcesso("Clientes"))
                {
                    <a asp-controller="Clientes" asp-action="Index" class="nav-link-item @(ctrl == "Clientes" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
                        <span>Clientes</span>
                    </a>
                }
                @if (TemAcesso("Contratos"))
                {
                    <a asp-controller="Contratos" asp-action="Index" class="nav-link-item @(ctrl == "Contratos" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                        <span>Contratos</span>
                    </a>
                }
            </div>

            <!-- ADMIN -->
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-group">
                    <div class="nav-group-label">ADMIN</div>
                    <a asp-controller="Usuarios" asp-action="Index" class="nav-link-item @(ctrl == "Usuarios" ? "active" : "")">
                        <span class="nav-icon"><i class="bi bi-person-gear"></i></span>
                        <span>Usuários</span>
                    </a>
                </div>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    @(_currentUser?.Iniciais ?? User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@(_currentUser?.Nome ?? User.Identity?.Name?.Split('@')[0])</div>
                    <div class="sidebar-user-role">
                        @(User.IsInRole("Admin") ? "Administrador" : User.IsInRole("Cliente") ? "Cliente" : User.IsInRole("ColaboradorExterno") ? "Colaborador" : "Equipe")
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link text-white-50 p-0" title="Sair">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main-wrapper">
        <!-- TOPBAR -->
        <header class="topbar">
            <button class="btn btn-link topbar-toggle d-lg-none" id="sidebarToggle">
                <i class="bi bi-list fs-4 text-dark"></i>
            </button>

            <div class="topbar-breadcrumb d-none d-md-flex align-items-center gap-2">
                <span class="text-muted small">AgenciaOS</span>
                <i class="bi bi-chevron-right text-muted" style="font-size:10px;"></i>
                <span class="fw-600 small">@ViewData["Title"]</span>
            </div>

            <div class="ms-auto d-flex align-items-center gap-2">
                <!-- Notificações -->
                <div class="dropdown">
                    <button class="topbar-btn position-relative" data-bs-toggle="dropdown" id="notifBtn">
                        <i class="bi bi-bell"></i>
                        <span class="notif-dot d-none" id="notifCount"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notif-dropdown shadow-lg border-0 p-0" style="width:360px;">
                        <div class="notif-dropdown-header">
                            <span class="fw-700">Notificações</span>
                            <button class="btn btn-link btn-sm p-0 text-primary" onclick="marcarTodasLidas()">Marcar todas</button>
                        </div>
                        <div id="notifList" class="notif-list">
                            <div class="notif-empty">
                                <i class="bi bi-bell-slash fs-3 text-muted d-block mb-2"></i>
                                <span class="text-muted small">Sem notificações</span>
                            </div>
                        </div>
                        <div class="notif-dropdown-footer">
                            <a asp-controller="Notificacoes" asp-action="Index" class="text-primary text-decoration-none small fw-500">
                                Ver todas <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- User menu -->
                <div class="dropdown">
                    <button class="topbar-user-btn" data-bs-toggle="dropdown">
                        <div class="topbar-avatar">@(_currentUser?.Iniciais ?? User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")</div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width:200px;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-600 small">@(_currentUser?.NomeCompleto ?? User.Identity?.Name?.Split('@')[0])</div>
                            <div class="text-muted" style="font-size:11px;">@User.Identity?.Name</div>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sair
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- PAGE -->
        <main class="page-main">
            @if (TempData["Sucesso"] != null)
            {
                <div class="toast-notification toast-success show" id="toastMsg">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
                </div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="toast-notification toast-danger show" id="toastMsg">
                    <i class="bi bi-exclamation-circle-fill"></i> @TempData["Erro"]
                </div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
