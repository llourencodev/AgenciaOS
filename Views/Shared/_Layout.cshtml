<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AgenciaOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;0,14..32,900;1,14..32,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @{
        @inject AgenciaOS.Data.ApplicationDbContext _cfgDb
        var _cfg = await _cfgDb.Configuracoes.OrderBy(c => c.Id).FirstOrDefaultAsync() ?? new AgenciaOS.Models.Configuracao();
    }
    <style>
        :root {
            --primary:       @_cfg.CorPrimaria;
            --primary-dark:  @_cfg.CorPrimariaDark;
            --primary-light: @(_cfg.CorPrimaria)18;
            --primary-rgb:   @(HexToRgb(_cfg.CorPrimaria));
            --grad-primary:  @_cfg.GradienteIcone;
            --grad-saudacao: @_cfg.GradienteSaudacao;
            --sb-bg:         @_cfg.CorSidebar;
            --cor-texto-primaria: @_cfg.CorTextoSobrePrimaria;
        }
        /* ── SIDEBAR BACKGROUND ── */
        .sidebar { background: @_cfg.CorSidebar !important; }
        .sidebar::before { background: radial-gradient(circle, @(_cfg.CorPrimaria)28 0%, transparent 70%) !important; }
        .sidebar::after  { background: radial-gradient(circle, @(_cfg.CorSecundaria)15 0%, transparent 70%) !important; }

        @if (_cfg.SidebarClara)
        {
            <text>
        /* ── SIDEBAR CLARA ── */
        .sidebar { background: #ffffff !important; border-right: 1.5px solid #e8eaf2 !important; box-shadow: 4px 0 20px rgba(0,0,0,.06) !important; }
        .nav-group-label { color: #94a3b8 !important; }
        .nav-link-item { color: #475569 !important; }
        .nav-link-item:hover { background: @(_cfg.CorPrimaria)12 !important; color: @_cfg.CorPrimaria !important; }
        .nav-link-item:hover .nav-icon { filter: none !important; }
        .nav-link-item.active { background: @(_cfg.CorPrimaria)15 !important; color: @_cfg.CorPrimaria !important; }
        .brand-name { color: #0f172a !important; }
        .brand-tagline { color: #94a3b8 !important; }
        .sidebar-user-name { color: #0f172a !important; }
        .sidebar-user-role { color: #64748b !important; }
        .sb-logout-btn { background: #f1f5f9 !important; color: #64748b !important; }
        .sb-logout-btn:hover { background: #fee2e2 !important; color: #ef4444 !important; }
        .ni-indigo, .ni-blue, .ni-green, .ni-amber, .ni-cyan, .ni-rose, .ni-violet, .ni-slate, .ni-red
            { filter: none !important; }
            </text>
        }

        /* ── LOGO SIZE ── */
        @{ var logoH = _cfg.TamanhoLogo switch { "sm" => "36px", "lg" => "72px", "xl" => "96px", _ => "52px" }; }
        .brand-logo-img { height: @logoH !important; max-width: 160px !important; width: auto !important; object-fit: contain !important; }
        .brand-logo { width: @(int.Parse(logoH.Replace("px","")) > 50 ? "52" : "44")px !important; height: @(int.Parse(logoH.Replace("px","")) > 50 ? "52" : "44")px !important; }


        /* ── BRAND COLORS ── */
        .brand-logo, .topbar-avatar, .sidebar-user-avatar { background: @_cfg.GradienteIcone !important; }

        /* ── BOTÕES ── */
        .btn-primary { background: @_cfg.GradienteIcone !important; border-color: transparent !important; color: @_cfg.CorTextoSobrePrimaria !important; box-shadow: 0 4px 14px rgba(0,0,0,.25) !important; }
        .btn-primary:hover { filter: brightness(1.08) !important; box-shadow: 0 6px 20px rgba(0,0,0,.35) !important; }

        /* ── NAV ATIVO — sobrescreve QUALQUER cor de ícone ── */
        .nav-link-item.active { background: linear-gradient(90deg, @(_cfg.CorPrimaria)33 0%, @(_cfg.CorPrimaria)0d 100%) !important; }
        .nav-link-item.active .nav-icon { background: @_cfg.GradienteIcone !important; color: @_cfg.CorTextoSobrePrimaria !important; box-shadow: 0 6px 20px rgba(0,0,0,.3) !important; }
        .nav-link-item.active::before { background: @_cfg.GradienteIcone !important; }

        /* ── BANNER SAUDAÇÃO ── */
        .saudacao-banner { background: @_cfg.GradienteSaudacao !important; }

        /* ── FOCO, BORDAS, CHECKS ── */
        .form-control:focus, .form-select:focus { border-color: @_cfg.CorPrimaria !important; box-shadow: 0 0 0 3px @(_cfg.CorPrimaria)22 !important; }
        .form-check-input:checked { background-color: @_cfg.CorPrimaria !important; border-color: @_cfg.CorPrimaria !important; }

        /* ── TOPBAR BOTÃO HOVER ── */
        .topbar-btn:hover { background: @(_cfg.CorPrimaria)18 !important; color: @_cfg.CorPrimaria !important; }

        /* ── TABELA HOVER ── */
        .table-hover tbody tr:hover { background: @(_cfg.CorPrimaria)08 !important; }

        /* ── BOARD COUNT BADGE ── */
        .board-col-count { background: @(_cfg.CorPrimaria)18 !important; color: @_cfg.CorPrimaria !important; }

        /* ── PRIMARY LIGHT ── */
        .text-primary { color: @_cfg.CorPrimaria !important; }
        .btn-link { color: @_cfg.CorPrimaria !important; }
        .primary-light { background: @(_cfg.CorPrimaria)18 !important; }
    </style>
    @functions {
        static string HexToRgb(string hex) {
            hex = hex.TrimStart('#');
            if (hex.Length == 6) {
                int r = Convert.ToInt32(hex[..2], 16);
                int g = Convert.ToInt32(hex[2..4], 16);
                int b = Convert.ToInt32(hex[4..6], 16);
                return $"{r},{g},{b}";
            }
            return "99,102,241";
        }
    }
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    @inject AgenciaOS.Data.ApplicationDbContext _layoutDb
    @inject Microsoft.AspNetCore.Identity.UserManager<AgenciaOS.Models.Usuario> _layoutUserMgr

    var _currentUser = await _layoutUserMgr.GetUserAsync(User);
    var _abas = _currentUser?.AbasPermitidas?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? [];
    bool TemAcesso(string aba) => !_abas.Any() || User.IsInRole("Admin") || _abas.Contains(aba);
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var _cfgLayout = await _layoutDb.Configuracoes.OrderBy(c => c.Id).FirstOrDefaultAsync() ?? new AgenciaOS.Models.Configuracao();

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="sidebar" id="sidebar">
        <!-- BRAND -->
        <div class="sidebar-brand">
            @if (!string.IsNullOrEmpty(_cfgLayout.LogoUrl))
            {
                <img src="@_cfgLayout.LogoUrl" alt="@_cfgLayout.NomeAgencia" class="brand-logo-img" />
            }
            else
            {
                <div class="brand-logo">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
            }
            <div class="brand-text">
                <span class="brand-name">@_cfgLayout.NomeAgencia</span>
                <span class="brand-tagline">@_cfgLayout.Tagline</span>
            </div>
        </div>

        <!-- NAV -->
        <nav class="sidebar-nav">

            <!-- GESTÃO -->
            <div class="nav-group">
                <div class="nav-group-label">Gestão</div>

                @if (TemAcesso("Dashboard"))
                {
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="nav-link-item @(ctrl=="Dashboard"?"active":"")">
                        <span class="nav-icon ni-indigo"><i class="bi bi-grid-1x2-fill"></i></span>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }
                @if (TemAcesso("Tarefas"))
                {
                    <a asp-controller="Tarefas" asp-action="Index"
                       class="nav-link-item @(ctrl=="Tarefas"?"active":"")">
                        <span class="nav-icon ni-blue"><i class="bi bi-kanban-fill"></i></span>
                        <span class="nav-label">Tarefas</span>
                    </a>
                }
                @if ((User.IsInRole("Admin") || User.IsInRole("Equipe")) && TemAcesso("Financeiro"))
                {
                    <a asp-controller="Financeiro" asp-action="Index"
                       class="nav-link-item @(ctrl=="Financeiro"?"active":"")">
                        <span class="nav-icon ni-green"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span class="nav-label">Financeiro</span>
                    </a>
                }
            </div>

            <!-- CRIATIVO -->
            <div class="nav-group">
                <div class="nav-group-label">Criativo</div>

                @if (TemAcesso("Calendario"))
                {
                    <a asp-controller="Calendario" asp-action="Index"
                       class="nav-link-item @(ctrl=="Calendario"?"active":"")">
                        <span class="nav-icon ni-amber"><i class="bi bi-calendar3-week-fill"></i></span>
                        <span class="nav-label">Calendário</span>
                    </a>
                }
                @if (TemAcesso("Arquivos"))
                {
                    <a asp-controller="Arquivos" asp-action="Index"
                       class="nav-link-item @(ctrl=="Arquivos"?"active":"")">
                        <span class="nav-icon ni-cyan"><i class="bi bi-folder2-open"></i></span>
                        <span class="nav-label">Arquivos</span>
                    </a>
                }
                @if (TemAcesso("DatasComemorativas"))
                {
                    <a asp-controller="DatasComemorativas" asp-action="Index"
                       class="nav-link-item @(ctrl=="DatasComemorativas"?"active":"")">
                        <span class="nav-icon ni-rose"><i class="bi bi-calendar-heart-fill"></i></span>
                        <span class="nav-label">Datas Comemorativas</span>
                    </a>
                }
            </div>

            <!-- COMERCIAL -->
            <div class="nav-group">
                <div class="nav-group-label">Comercial</div>

                @if (TemAcesso("Clientes"))
                {
                    <a asp-controller="Clientes" asp-action="Index"
                       class="nav-link-item @(ctrl=="Clientes"?"active":"")">
                        <span class="nav-icon ni-violet"><i class="bi bi-people-fill"></i></span>
                        <span class="nav-label">Clientes</span>
                    </a>
                }
                @if (TemAcesso("Contratos"))
                {
                    <a asp-controller="Contratos" asp-action="Index"
                       class="nav-link-item @(ctrl=="Contratos"?"active":"")">
                        <span class="nav-icon ni-slate"><i class="bi bi-file-earmark-text-fill"></i></span>
                        <span class="nav-label">Contratos</span>
                    </a>
                }
            </div>

            <!-- ADMIN -->
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-group">
                    <div class="nav-group-label">Admin</div>
                    <a asp-controller="Usuarios" asp-action="Index"
                       class="nav-link-item @(ctrl=="Usuarios"?"active":"")">
                        <span class="nav-icon ni-red"><i class="bi bi-person-gear"></i></span>
                        <span class="nav-label">Usuários</span>
                    </a>
                    <a asp-controller="Configuracao" asp-action="Index"
                       class="nav-link-item @(ctrl=="Configuracao"?"active":"")">
                        <span class="nav-icon ni-slate"><i class="bi bi-palette-fill"></i></span>
                        <span class="nav-label">Personalização</span>
                    </a>
                </div>
            }
        </nav>

        <!-- FOOTER -->
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    @(_currentUser?.Iniciais ?? User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@(_currentUser?.NomeCompleto ?? User.Identity?.Name?.Split('@')[0])</div>
                    <div class="sidebar-user-role">
                        @(User.IsInRole("Admin") ? "Administrador" : User.IsInRole("Cliente") ? "Cliente" : User.IsInRole("ColaboradorExterno") ? "Colaborador" : "Equipe")
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sb-logout-btn" title="Sair">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main-wrapper">
        <header class="topbar">
            <button class="btn btn-link topbar-toggle d-lg-none p-1" id="sidebarToggle">
                <i class="bi bi-list fs-4 text-dark"></i>
            </button>
            <div class="topbar-breadcrumb d-none d-md-flex align-items-center gap-2">
                <span class="text-muted small">AgenciaOS</span>
                <i class="bi bi-chevron-right text-muted" style="font-size:9px;"></i>
                <span class="fw-600 small">@ViewData["Title"]</span>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="topbar-btn position-relative" data-bs-toggle="dropdown" id="notifBtn">
                        <i class="bi bi-bell"></i>
                        <span class="notif-dot d-none" id="notifCount"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notif-dropdown shadow-lg border-0 p-0" style="width:360px;">
                        <div class="notif-dropdown-header">
                            <span class="fw-700">Notificações</span>
                            <button class="btn btn-link btn-sm p-0 text-primary" onclick="marcarTodasLidas()">Marcar todas</button>
                        </div>
                        <div id="notifList" class="notif-list">
                            <div class="notif-empty">
                                <i class="bi bi-bell-slash fs-3 text-muted d-block mb-2"></i>
                                <span class="text-muted small">Sem notificações</span>
                            </div>
                        </div>
                        <div class="notif-dropdown-footer">
                            <a asp-controller="Notificacoes" asp-action="Index" class="text-primary text-decoration-none small fw-500">
                                Ver todas <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="topbar-user-btn" data-bs-toggle="dropdown">
                        <div class="topbar-avatar">@(_currentUser?.Iniciais ?? "U")</div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width:200px;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-600 small">@(_currentUser?.NomeCompleto ?? User.Identity?.Name?.Split('@')[0])</div>
                            <div class="text-muted" style="font-size:11px;">@User.Identity?.Name</div>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sair
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="page-main">
            @if (TempData["Sucesso"] != null)
            {
                <div class="toast-notification toast-success show" id="toastMsg">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
                </div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="toast-notification toast-danger show" id="toastMsg">
                    <i class="bi bi-exclamation-circle-fill"></i> @TempData["Erro"]
                </div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
