@{
    var secao = ViewData["MktSecao"]?.ToString() ?? "";
    var ehAgencia = ViewData["MktAgencia"] as bool? ?? false;
    var clienteId = ViewData["MktClienteId"];
}
<div class="mkt-tabs">
    <a asp-controller="Marketing" asp-action="Index" asp-route-clienteId="@clienteId" class="mkt-tab @(secao=="geral"?"active":"")"><i class="bi bi-speedometer2"></i> Visão Geral</a>
    <a asp-controller="Marketing" asp-action="Conteudo" asp-route-clienteId="@clienteId" class="mkt-tab @(secao=="conteudo"?"active":"")"><i class="bi bi-images"></i> Desempenho de Conteúdo</a>
    <a asp-controller="Marketing" asp-action="Insights" asp-route-clienteId="@clienteId" class="mkt-tab @(secao=="insights"?"active":"")"><i class="bi bi-lightbulb-fill"></i> Insights</a>
    <a asp-controller="Marketing" asp-action="Relatorios" class="mkt-tab @(secao=="relatorios"?"active":"")"><i class="bi bi-file-earmark-pdf-fill"></i> Relatórios</a>
    <a asp-controller="Integracoes" asp-action="Index" asp-route-clienteId="@clienteId" class="mkt-tab @(secao=="integracoes"?"active":"")"><i class="bi bi-plug-fill"></i> Contas e Integrações</a>
    @if (ehAgencia)
    {
        <a asp-controller="Marketing" asp-action="Agencia" class="mkt-tab @(secao=="agencia"?"active":"")"><i class="bi bi-buildings-fill"></i> Carteira da Agência</a>
    }
</div>
